JWT_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_CODE_SECRET=replace-with-another-32-character-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Local LiveKit development server from infra/docker-compose.yml
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-0123456789-66msg-voice

