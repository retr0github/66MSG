JWT_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_CODE_SECRET=replace-with-another-32-character-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Local LiveKit development server from infra/docker-compose.yml.
# For a public server, use its public IP/domain, for example:
# LIVEKIT_URL=ws://109.73.195.40:7880
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-0123456789-66msg-voice

# Optional:
# Use 0.0.0.0 on a public server.
# MSG_SERVER_HOST=0.0.0.0
# MSG_SERVER_PORT=8080
# MSG_DATA_PATH=data/66msg.json
# TELEGRAM_PROXY_URL=http://127.0.0.1:2080
